# CITADEL — variáveis de ambiente (copie para .env; .env está no .gitignore)
# ---------------------------------------------------------------------------
# Sites Checkmk descentralizados (um por edge). JSON em linha única.
# O automation user deve ter role mínima (admin de hosts/downtimes, sem wato global).
CITADEL_CHECKMK_SITES='[{"id":"tesp03","url":"https://cmk-tesp03.interno.totvs/tesp03","user":"citadel_api","secret":"TROQUE-ME"}]'
# Fabrics ACI (um APIC por parque) — mapa de portas + silenciamento de acesso.
# cmk_site liga o fabric ao site Checkmk (id em CITADEL_CHECKMK_SITES) que
# monitora os leafs daquele parque. verify_tls=false: APICs são self-signed.
CITADEL_ACI_FABRICS='[{"id":"TESP6","apic_url":"https://IP-DO-APIC","user":"admin","secret":"TROQUE-ME","verify_tls":false,"cmk_site":"tesp6"}]'
# Corvo — varredura do canal de alertas
SLACK_BOT_TOKEN=xoxb-TROQUE-ME
CORVO_CHANNEL_ID=C05JX7J5MMY
# API
CITADEL_ENV=dev
# Corvo — Datadog On-Call (#datadog-redes → DM do Bruno). App Slack "Corvo" em Socket Mode:
# deploy/slack-app-manifest-corvo.yml. SLACK_BOT_TOKEN acima é reaproveitado (xoxb-).
SLACK_APP_TOKEN=xapp-TROQUE-ME
CORVO_DATADOG_CHANNEL_ID=C087SV98MBM
CORVO_DATADOG_BOT_USER=U07Q4UQU0GM
# quem recebe o relatório diário (user ids, vírgula) — Bruno:
CORVO_REPORT_TO=U3BBS1RA6
# quem pode falar com o bot na DM (default = CORVO_REPORT_TO)
CORVO_BOT_ALLOWED_USERS=U3BBS1RA6,U053RFRVBE1
# CORVO_DATA_DIR=data            # SQLite corvo_datadog.sqlite
# CORVO_REPORT_DIR=relatorios/corvo-datadog
# CORVO_RESPONSE_WINDOW_S=1800   # janela p/ atribuir mensagem do canal a uma page
