{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/dominio/**",
              "ui_kits/citadel/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:TOTVS|Archivo|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: TOTVS, Archivo, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|block|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, block, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|mono|width|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, align, mono, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DomainTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|state|days|note|usagePct|env|selected|dark|onClick|style|key|ref|className|style|children)$/]",
        "message": "<DomainTile> doesn't accept that prop. Declared props: code, state, days, note, usagePct, env, selected, dark, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DomainTile'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:ok|warn|crit|emergency|stale|nocollect|unknown)$/]",
        "message": "<DomainTile> state must be one of 'ok' | 'warn' | 'crit' | 'emergency' | 'stale' | 'nocollect' | 'unknown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|footer|onClose|width|inline|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, children, footer, onClose, width, inline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProvenanceChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:method|source|age|confidence|stale|lang|style|key|ref|className|style|children)$/]",
        "message": "<ProvenanceChip> doesn't accept that prop. Declared props: method, source, age, confidence, stale, lang, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProvenanceChip'] > JSXAttribute[name.name='method'] > Literal[value!=/^(?:OBS|CALC|EST|MAN)$/]",
        "message": "<ProvenanceChip> method must be one of 'OBS' | 'CALC' | 'EST' | 'MAN'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProvenanceChip'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:pt|en)$/]",
        "message": "<ProvenanceChip> lang must be one of 'pt' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunwayBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:usage|opLimit|techLimit|label|caption|days|confidence|state|nocollect|height|style|key|ref|className|style|children)$/]",
        "message": "<RunwayBar> doesn't accept that prop. Declared props: usage, opLimit, techLimit, label, caption, days, confidence, state, nocollect, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunwayBar'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:ok|warn|crit|emergency|stale|nocollect)$/]",
        "message": "<RunwayBar> state must be one of 'ok' | 'warn' | 'crit' | 'emergency' | 'stale' | 'nocollect'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|options|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, value, options, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|lang|filled|glyphOnly|style|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: state, label, lang, filled, glyphOnly, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:info|ok|warn|crit|emergency|unknown|unavailable|nocollect|stale|divergent)$/]",
        "message": "<StatusBadge> state must be one of 'info' | 'ok' | 'warn' | 'crit' | 'emergency' | 'unknown' | 'unavailable' | 'nocollect' | 'stale' | 'divergent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:pt|en)$/]",
        "message": "<StatusBadge> lang must be one of 'pt' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, active, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|placeholder|hint|error|mono|disabled|type|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, placeholder, hint, error, mono, disabled, type, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|detail|actionLabel|onAction|onClose|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: kind, title, detail, actionLabel, onAction, onClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:info|ok|warn|crit|nocollect|stale|divergent)$/]",
        "message": "<Toast> kind must be one of 'info' | 'ok' | 'warn' | 'crit' | 'nocollect' | 'stale' | 'divergent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrajectoryChartEvent'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|label|key|ref|className|style|children)$/]",
        "message": "<TrajectoryChartEvent> doesn't accept that prop. Declared props: index, label."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
